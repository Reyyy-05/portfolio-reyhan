---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;

const statusColors: Record<string, string> = {
  'MVP': 'text-accent bg-accent/5 border-accent/15',
  'In Development': 'text-accent-secondary bg-accent-secondary/5 border-accent-secondary/15',
  'Academic': 'text-text-dim bg-text-dim/5 border-text-dim/15',
  'Collaboration': 'text-accent-secondary bg-accent-secondary/5 border-accent-secondary/15',
  'Internship Project': 'text-success bg-success/5 border-success/15',
  'Experiment': 'text-text-muted bg-text-muted/5 border-text-muted/15',
  'Production': 'text-success bg-success/5 border-success/15',
};

const typeIcons: Record<string, string> = {
  web: '◈',
  mobile: '◇',
  data: '◆',
  product: '○',
};

const statusClass = statusColors[project.status] || statusColors['MVP'];

// Unique ID for each card's tab group
const cardId = project.title.replace(/\s+/g, '-').toLowerCase();

// Determine initial view
const hasViews = project.views && project.views.length > 0;
const firstViewId = hasViews ? project.views![0].id : null;
---

{featured ? (
  <!-- Featured Project Card with Interactive View Switcher -->
  <div class="space-y-4 group reveal flex flex-col justify-between h-full" data-card-id={cardId}>
    <div class="space-y-4">
      <!-- Tab Pills Row -->
      {hasViews && (
        <div class="flex items-center gap-1.5 flex-wrap" role="tablist" aria-label={`${project.title} views`}>
          {project.views!.map((view, i) => (
            <button
              id={`tab-${cardId}-${view.id}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${cardId}-${view.id}`}
              data-tab={view.id}
              data-card={cardId}
              class:list={[
                'view-tab-btn font-mono text-[9px] uppercase tracking-wider border rounded-lg px-2.5 py-1 transition-all duration-200 cursor-pointer',
                i === 0
                  ? 'bg-accent/10 border-accent/30 text-accent'
                  : 'bg-transparent border-border/40 text-text-dim hover:border-border-strong hover:text-text-muted',
              ]}
            >
              {view.label}
            </button>
          ))}
        </div>
      )}

      <!-- Visual Card Container (Mockup frame with per-view panels) -->
      <div class="editorial-card card-teal-glow overflow-hidden border border-border/85 bg-surface/30 aspect-[16/10] flex items-center justify-center p-6 sm:p-8 relative select-none hover:shadow-[0_12px_45px_-12px_rgba(94,234,212,0.06)]">

        <!-- ──────────────── IMGN CATALOG ──────────────── -->
        {project.title === 'IMGN Concept Web Catalog' && (
          <>
            <!-- View: Catalog (default) -->
            <div id={`panel-${cardId}-catalog`} data-panel={`${cardId}-catalog`} class="view-panel w-full max-w-[260px] sm:max-w-[320px] aspect-[4/3] flex flex-col group-hover:scale-[1.02] transition-transform duration-500">
              <div class="css-browser w-full h-full flex flex-col">
                <div class="css-browser-bar">
                  <div class="css-browser-dot"></div>
                  <div class="css-browser-dot"></div>
                  <div class="css-browser-dot"></div>
                  <div class="css-browser-address">imgnconcept.com/catalog</div>
                </div>
                <div class="p-3.5 flex-1 flex flex-col justify-between bg-bg-alt text-[8px]">
                  <div class="h-2 w-1/3 bg-border rounded"></div>
                  <div class="grid grid-cols-2 gap-2 my-auto">
                    <div class="border border-border/60 rounded-md p-1.5 bg-surface/50 space-y-1.5">
                      <div class="h-8 w-full bg-border-strong/60 rounded flex items-center justify-center text-[7px] text-text-dim">📷 Part A</div>
                      <div class="h-1.5 w-2/3 bg-border rounded"></div>
                    </div>
                    <div class="border border-border/60 rounded-md p-1.5 bg-surface/50 space-y-1.5">
                      <div class="h-8 w-full bg-border-strong/60 rounded flex items-center justify-center text-[7px] text-text-dim">📷 Part B</div>
                      <div class="h-1.5 w-1/2 bg-border rounded"></div>
                    </div>
                  </div>
                  <div class="flex items-center justify-between border-t border-border/40 pt-1.5">
                    <div class="h-1.5 w-1/4 bg-border rounded"></div>
                    <div class="h-2.5 w-7 bg-success/10 border border-success/25 rounded-sm text-[5px] text-success text-center flex items-center justify-center">Active</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- View: Product Detail -->
            <div id={`panel-${cardId}-detail`} data-panel={`${cardId}-detail`} class="view-panel hidden w-full max-w-[260px] sm:max-w-[320px] aspect-[4/3] flex-col group-hover:scale-[1.02] transition-transform duration-500">
              <div class="css-browser w-full h-full flex flex-col">
                <div class="css-browser-bar">
                  <div class="css-browser-dot"></div>
                  <div class="css-browser-dot"></div>
                  <div class="css-browser-dot"></div>
                  <div class="css-browser-address">imgnconcept.com/product/42</div>
                </div>
                <div class="p-3.5 flex-1 flex gap-3 bg-bg-alt text-[8px]">
                  <div class="w-2/5 bg-border-strong/50 rounded-md flex items-center justify-center text-[7px] text-text-dim">📷 Foto</div>
                  <div class="flex-1 space-y-2 flex flex-col justify-center">
                    <div class="h-2.5 w-full bg-border rounded"></div>
                    <div class="h-1.5 w-2/3 bg-border/60 rounded"></div>
                    <div class="h-1.5 w-1/2 bg-accent/20 rounded"></div>
                    <div class="space-y-1 pt-1 border-t border-border/30">
                      <div class="h-1 w-full bg-border/40 rounded"></div>
                      <div class="h-1 w-4/5 bg-border/40 rounded"></div>
                    </div>
                    <div class="h-4 w-2/3 bg-accent/15 border border-accent/25 rounded text-[6px] text-accent flex items-center justify-center mt-auto">Hubungi Kami</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- View: Admin Panel -->
            <div id={`panel-${cardId}-admin`} data-panel={`${cardId}-admin`} class="view-panel hidden w-full max-w-[260px] sm:max-w-[320px] aspect-[4/3] flex-col group-hover:scale-[1.02] transition-transform duration-500">
              <div class="css-browser w-full h-full flex flex-col">
                <div class="css-browser-bar">
                  <div class="css-browser-dot"></div>
                  <div class="css-browser-dot"></div>
                  <div class="css-browser-dot"></div>
                  <div class="css-browser-address">imgnconcept.com/admin/inventory</div>
                </div>
                <div class="p-3.5 flex-1 flex flex-col gap-2 bg-bg-alt text-[8px]">
                  <div class="flex items-center justify-between border-b border-border/40 pb-1.5">
                    <span class="text-text-muted font-mono uppercase text-[7px]">/ INVENTORY DASHBOARD</span>
                    <span class="text-success text-[6px] bg-success/10 border border-success/20 px-1 rounded">Admin</span>
                  </div>
                  <div class="space-y-1.5 flex-1">
                    {['Part Modif A', 'Velg Custom B', 'Body Kit C'].map((item, i) => (
                      <div class="flex items-center gap-2 border border-border/40 rounded bg-surface/40 px-2 py-1">
                        <div class="w-4 h-4 bg-border-strong/50 rounded flex-shrink-0"></div>
                        <div class="flex-1 space-y-0.5">
                          <div class="h-1.5 w-3/4 bg-border rounded"></div>
                          <div class="h-1 w-1/2 bg-border/50 rounded"></div>
                        </div>
                        <span class="text-[6px] text-accent font-mono">Stock {12 - i * 3}</span>
                      </div>
                    ))}
                  </div>
                  <div class="flex gap-1.5 border-t border-border/40 pt-1.5">
                    <div class="flex-1 h-4 bg-accent/10 border border-accent/25 rounded text-[6px] text-accent flex items-center justify-center">+ Add Product</div>
                    <div class="flex-1 h-4 bg-surface border border-border/40 rounded text-[6px] text-text-dim flex items-center justify-center">Export CSV</div>
                  </div>
                </div>
              </div>
            </div>
          </>
        )}

        <!-- ──────────────── STATPROV ──────────────── -->
        {project.title === 'StatProv' && (
          <>
            <!-- View: Dashboard -->
            <div id={`panel-${cardId}-dashboard`} data-panel={`${cardId}-dashboard`} class="view-panel w-full max-w-[260px] sm:max-w-[320px] aspect-[4/3] flex flex-col justify-between border border-border/85 bg-[#0b0c0f] p-4 rounded-lg text-[8px] group-hover:scale-[1.02] transition-transform duration-500 css-data-grid">
              <div class="flex items-center justify-between border-b border-border/60 pb-2">
                <span class="text-text-muted font-mono uppercase tracking-wider">/ DATA PROVENANCE</span>
                <span class="text-accent font-mono font-medium">SHA-256 OK</span>
              </div>
              <div class="space-y-2.5 my-auto font-mono">
                <div class="flex items-center justify-between border-b border-border/30 pb-1">
                  <span class="text-text-dim">dataset_integrity()</span>
                  <span class="text-success">✓ VALID</span>
                </div>
                <div class="space-y-0.5 bg-bg-alt p-2 rounded border border-border/40 text-[7px] text-text-dim">
                  <p>SRC: UNU-Yogya/Prov</p>
                  <p>REF: 0x9B169F2C...</p>
                  <p>VERIFIED: ADMIN_AUTH</p>
                </div>
              </div>
              <div class="flex justify-between items-center border-t border-border/60 pt-2 text-text-dim font-mono">
                <span>SYSTEM ACTIVE</span>
                <span>v1.0.0</span>
              </div>
            </div>

            <!-- View: Verification -->
            <div id={`panel-${cardId}-verify`} data-panel={`${cardId}-verify`} class="view-panel hidden w-full max-w-[260px] sm:max-w-[320px] aspect-[4/3] flex-col justify-between border border-border/85 bg-[#0b0c0f] p-4 rounded-lg text-[8px] group-hover:scale-[1.02] transition-transform duration-500 css-data-grid">
              <div class="flex items-center justify-between border-b border-border/60 pb-2">
                <span class="text-text-muted font-mono uppercase tracking-wider">/ HASH VERIFY</span>
                <span class="text-accent font-mono text-[7px]">SHA-256</span>
              </div>
              <div class="space-y-2 my-auto font-mono">
                <div class="bg-bg-alt border border-border/40 rounded p-2 space-y-1.5">
                  <p class="text-[7px] text-text-dim uppercase">File Input</p>
                  <div class="h-4 bg-surface border border-border/60 rounded flex items-center px-1.5">
                    <span class="text-[6px] text-text-dim">dataset_unu_2026.csv</span>
                  </div>
                </div>
                <div class="flex items-center gap-1.5">
                  <div class="flex-1 h-0.5 bg-accent/20"></div>
                  <span class="text-[6px] text-accent">Computing...</span>
                  <div class="flex-1 h-0.5 bg-accent/20"></div>
                </div>
                <div class="bg-bg-alt border border-accent/20 rounded p-2">
                  <p class="text-[6px] text-accent uppercase mb-1">Hash Result</p>
                  <p class="text-[6px] text-text-dim font-mono break-all">0x9B169F2C4A7E...</p>
                  <p class="text-[6px] text-success mt-1">✓ Match — Integrity OK</p>
                </div>
              </div>
              <div class="flex justify-between items-center border-t border-border/60 pt-2 text-text-dim font-mono">
                <span>VERIFIED</span>
                <span class="text-success">PASS</span>
              </div>
            </div>

            <!-- View: CSV Preview -->
            <div id={`panel-${cardId}-preview`} data-panel={`${cardId}-preview`} class="view-panel hidden w-full max-w-[260px] sm:max-w-[320px] aspect-[4/3] flex-col justify-between border border-border/85 bg-[#0b0c0f] p-3 rounded-lg text-[7px] group-hover:scale-[1.02] transition-transform duration-500 css-data-grid">
              <div class="flex items-center justify-between border-b border-border/60 pb-1.5">
                <span class="text-text-muted font-mono uppercase tracking-wider text-[7px]">/ CSV PREVIEW</span>
                <span class="text-accent font-mono">104 rows</span>
              </div>
              <div class="flex-1 my-1.5 overflow-hidden">
                <div class="grid grid-cols-4 gap-px text-[6px] font-mono">
                  {['ID', 'Kode', 'Nilai', 'Status'].map(h => (
                    <div class="bg-surface/60 border border-border/40 px-1 py-0.5 text-accent text-center">{h}</div>
                  ))}
                  {['001', 'DS-A', '98.2', 'VALID'].map(c => (
                    <div class="border-b border-border/20 px-1 py-0.5 text-text-dim text-center">{c}</div>
                  ))}
                  {['002', 'DS-B', '76.5', 'OK'].map(c => (
                    <div class="border-b border-border/20 px-1 py-0.5 text-text-dim text-center">{c}</div>
                  ))}
                  {['003', 'DS-C', '45.1', 'WARN'].map(c => (
                    <div class="border-b border-border/20 px-1 py-0.5 text-accent-secondary text-center">{c}</div>
                  ))}
                </div>
              </div>
              <div class="flex justify-between border-t border-border/60 pt-1.5 text-text-dim font-mono">
                <span>Rows: 3/104 shown</span>
                <span class="text-success">Export OK</span>
              </div>
            </div>
          </>
        )}

        <!-- ──────────────── BIOLEARN ──────────────── -->
        {project.title === 'BioLearn' && (
          <>
            <!-- View: Home -->
            <div id={`panel-${cardId}-home`} data-panel={`${cardId}-home`} class="view-panel css-phone w-36 sm:w-40 flex flex-col bg-bg-alt group-hover:scale-[1.02] transition-transform duration-500">
              <div class="css-phone-notch"></div>
              <div class="p-2.5 flex-1 flex flex-col justify-between text-[8px]">
                <div class="flex items-center justify-between border-b border-border/60 pb-1">
                  <span class="font-medium text-text">BioLearn Mobile</span>
                  <span class="text-accent font-mono">MVP</span>
                </div>
                <div class="border border-border/80 rounded bg-bg aspect-video flex items-center justify-center my-2 relative overflow-hidden">
                  <div class="w-5 h-5 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center text-accent">▶</div>
                  <div class="absolute bottom-1 left-1 right-1 h-1 bg-accent/20 rounded">
                    <div class="w-2/3 h-full bg-accent rounded"></div>
                  </div>
                </div>
                <div class="space-y-1.5 flex-1 flex flex-col justify-center">
                  <div class="h-1.5 w-3/4 bg-border rounded"></div>
                  <div class="space-y-1 pt-1 font-mono text-[7px]">
                    <div class="flex items-center gap-1">
                      <span class="w-1.5 h-1.5 border border-accent/50 rounded-sm bg-accent/10 text-accent flex items-center justify-center text-[5px]">✓</span>
                      <span class="text-text-dim">Cell Organelles</span>
                    </div>
                    <div class="flex items-center gap-1">
                      <span class="w-1.5 h-1.5 border border-border/50 rounded-sm"></span>
                      <span class="text-text-dim">Genetics DNA</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- View: Module Player -->
            <div id={`panel-${cardId}-player`} data-panel={`${cardId}-player`} class="view-panel hidden css-phone w-36 sm:w-40 flex-col bg-bg-alt group-hover:scale-[1.02] transition-transform duration-500">
              <div class="css-phone-notch"></div>
              <div class="p-2.5 flex-1 flex flex-col gap-1.5 text-[7px]">
                <div class="border border-border/40 rounded bg-bg-alt aspect-video relative overflow-hidden">
                  <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent flex items-center justify-center">
                    <div class="w-6 h-6 rounded-full bg-text/10 flex items-center justify-center text-text text-[10px]">▶</div>
                  </div>
                  <div class="absolute bottom-1 left-1 right-1 h-1 bg-surface rounded overflow-hidden">
                    <div class="w-1/3 h-full bg-accent rounded"></div>
                  </div>
                </div>
                <div class="font-medium text-text text-[8px]">Bab 3: Fotosintesis</div>
                <div class="space-y-0.5 flex-1">
                  {['Reaksi Terang', 'Siklus Calvin', 'Faktor Cahaya'].map((item, i) => (
                    <div class:list={['flex items-center gap-1 px-1 py-0.5 rounded', i === 0 ? 'bg-accent/10' : '']}>
                      <span class:list={['w-1 h-1 rounded-full', i === 0 ? 'bg-accent' : 'bg-border']}></span>
                      <span class:list={['text-[6px]', i === 0 ? 'text-accent' : 'text-text-dim']}>{item}</span>
                    </div>
                  ))}
                </div>
                <div class="border-t border-border/40 pt-1 grid grid-cols-3 gap-0.5 text-center font-mono text-[6px] text-text-dim">
                  <span>← Prev</span>
                  <span class="text-accent">●</span>
                  <span>Next →</span>
                </div>
              </div>
            </div>

            <!-- View: Quiz -->
            <div id={`panel-${cardId}-quiz`} data-panel={`${cardId}-quiz`} class="view-panel hidden css-phone w-36 sm:w-40 flex-col bg-bg-alt group-hover:scale-[1.02] transition-transform duration-500">
              <div class="css-phone-notch"></div>
              <div class="p-2.5 flex-1 flex flex-col gap-2 text-[7px]">
                <div class="flex items-center justify-between border-b border-border/60 pb-1">
                  <span class="font-medium text-text text-[8px]">Quiz Bab 3</span>
                  <span class="text-accent-secondary font-mono text-[6px]">4/10</span>
                </div>
                <div class="bg-bg-alt border border-border/40 rounded p-1.5 text-[6px] text-text-muted leading-relaxed">
                  Proses apa yang terjadi pada reaksi terang fotosintesis?
                </div>
                <div class="space-y-1">
                  {['A. Siklus Calvin', 'B. Fotofosforilasi', 'C. Glikolisis'].map((opt, i) => (
                    <div class:list={['border rounded px-1.5 py-0.5 text-[6px]', i === 1 ? 'border-accent/40 bg-accent/10 text-accent' : 'border-border/40 text-text-dim']}>
                      {opt}
                    </div>
                  ))}
                </div>
                <div class="mt-auto border-t border-border/40 pt-1.5 flex items-center justify-between">
                  <div class="text-[6px] text-text-dim">Skor: <span class="text-success">80</span>/100</div>
                  <div class="text-[6px] bg-accent/10 border border-accent/25 text-accent rounded px-1.5 py-0.5">Submit</div>
                </div>
              </div>
            </div>
          </>
        )}

        <!-- ──────────────── MASJIDFLOW ──────────────── -->
        {project.title === 'MasjidFlow' && (
          <>
            <!-- View: Agenda -->
            <div id={`panel-${cardId}-agenda`} data-panel={`${cardId}-agenda`} class="view-panel css-phone w-36 sm:w-40 flex flex-col bg-bg-alt group-hover:scale-[1.02] transition-transform duration-500">
              <div class="css-phone-notch"></div>
              <div class="p-2.5 flex-1 flex flex-col justify-between text-[8px]">
                <div class="flex items-center justify-between border-b border-border/60 pb-1">
                  <span class="font-medium text-text">MasjidFlow</span>
                  <span class="text-success font-mono">ACTIVE</span>
                </div>
                <div class="space-y-2 flex-1 flex flex-col justify-center py-2">
                  <div class="border border-border/85 rounded p-1 bg-surface/50 space-y-1">
                    <div class="flex justify-between items-center">
                      <span class="font-medium text-text">Friday Agenda</span>
                      <span class="text-[5px] text-success bg-success/10 border border-success/20 px-1 rounded-sm">Approved</span>
                    </div>
                    <div class="h-1 w-2/3 bg-border rounded"></div>
                  </div>
                  <div class="border border-border/85 rounded p-1 bg-surface/50 space-y-1">
                    <div class="flex justify-between items-center">
                      <span class="font-medium text-text">Youth Meetup</span>
                      <span class="text-[5px] text-accent bg-accent/10 border border-accent/20 px-1 rounded-sm">Pending</span>
                    </div>
                    <div class="h-1 w-1/2 bg-border rounded"></div>
                  </div>
                </div>
                <div class="grid grid-cols-3 gap-1 text-center border-t border-border/60 pt-1 text-[6px] text-text-dim font-mono">
                  <span class="text-accent">Flow</span>
                  <span>Agenda</span>
                  <span>Admin</span>
                </div>
              </div>
            </div>

            <!-- View: Event Form -->
            <div id={`panel-${cardId}-submission`} data-panel={`${cardId}-submission`} class="view-panel hidden css-phone w-36 sm:w-40 flex-col bg-bg-alt group-hover:scale-[1.02] transition-transform duration-500">
              <div class="css-phone-notch"></div>
              <div class="p-2.5 flex-1 flex flex-col gap-1.5 text-[7px]">
                <div class="border-b border-border/60 pb-1">
                  <span class="font-medium text-text text-[8px]">Ajukan Kegiatan</span>
                </div>
                <div class="space-y-1.5 flex-1">
                  {[{l:'Nama Kegiatan', v:'Kajian Subuh'}, {l:'Tanggal', v:'29 Agustus 2026'}, {l:'Tempat', v:'Aula Utama'}].map(f => (
                    <div class="space-y-0.5">
                      <span class="text-[6px] text-text-dim font-mono uppercase">{f.l}</span>
                      <div class="border border-border/60 rounded px-1.5 py-0.5 text-[6px] text-text-muted bg-surface/40">{f.v}</div>
                    </div>
                  ))}
                </div>
                <div class="h-4 bg-accent/15 border border-accent/30 rounded text-[6px] text-accent flex items-center justify-center mt-auto">Kirim Pengajuan</div>
              </div>
            </div>

            <!-- View: Admin Approval -->
            <div id={`panel-${cardId}-approval`} data-panel={`${cardId}-approval`} class="view-panel hidden css-phone w-36 sm:w-40 flex-col bg-bg-alt group-hover:scale-[1.02] transition-transform duration-500">
              <div class="css-phone-notch"></div>
              <div class="p-2.5 flex-1 flex flex-col gap-1.5 text-[7px]">
                <div class="flex items-center justify-between border-b border-border/60 pb-1">
                  <span class="font-medium text-text text-[8px]">Approval</span>
                  <span class="text-[5px] text-success bg-success/10 border border-success/15 rounded px-1">Admin</span>
                </div>
                <div class="space-y-1.5 flex-1">
                  {[
                    {name:'Kajian Subuh', by:'Panitia A', status:'Pending'},
                    {name:'Bazar Ramadan', by:'Panitia B', status:'Approved'},
                  ].map(ev => (
                    <div class="border border-border/40 rounded bg-surface/30 p-1 space-y-0.5">
                      <div class="flex items-center justify-between">
                        <span class="text-[6px] text-text font-medium">{ev.name}</span>
                        <span class:list={['text-[5px] rounded px-0.5', ev.status === 'Approved' ? 'text-success bg-success/10' : 'text-accent-secondary bg-accent-secondary/10']}>{ev.status}</span>
                      </div>
                      <span class="text-[5px] text-text-dim">{ev.by}</span>
                      {ev.status === 'Pending' && (
                        <div class="flex gap-0.5 pt-0.5">
                          <div class="flex-1 h-3 bg-success/15 border border-success/25 rounded text-[5px] text-success flex items-center justify-center">✓ Setuju</div>
