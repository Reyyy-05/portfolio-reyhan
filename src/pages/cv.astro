---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SocialSidebar from '../components/SocialSidebar.astro';

const pdfPath = '/cv-reyhan.pdf';
---

<BaseLayout
  title="Curriculum Vitae — Reyhan Albar Fahryan"
  description="Preview and download the professional resume / CV of Reyhan Albar Fahryan."
>
  <SocialSidebar />
  <Navbar />

  <main class="min-h-screen bg-bg pt-28 pb-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Header Section -->
      <div class="mb-10 reveal">
        <a href="/" class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider text-text-dim hover:text-accent transition-colors mb-6 group">
          <svg class="w-3 h-3 rotate-180 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          Back to Home
        </a>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent mb-2">/ CURRICULUM VITAE</p>
            <h1 class="text-4xl md:text-5xl font-bold tracking-tighter uppercase leading-[0.95] font-display text-text">
              Resume Preview
            </h1>
            <p class="text-sm text-text-muted mt-2 font-light">
              Reyhan Albar Fahryan — Informatics Student & Digital Product Builder
            </p>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center gap-3 flex-wrap shrink-0">
            <a
              href={pdfPath}
              download="CV_Reyhan_Albar_Fahryan.pdf"
              id="download-cv-btn"
              class="bg-accent text-bg font-medium px-5 py-2.5 rounded-xl hover:bg-accent/90 transition-all duration-300 shadow-sm hover:shadow-[0_8px_20px_-6px_rgba(94,234,212,0.3)] text-xs uppercase tracking-wider font-mono inline-flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              Download PDF
            </a>

            <a
              href={pdfPath}
              target="_blank"
              rel="noopener noreferrer"
              class="border border-border text-text-muted px-4 py-2.5 rounded-xl hover:border-border-strong hover:bg-surface hover:text-text transition-all duration-300 text-xs inline-flex items-center gap-1.5 font-mono uppercase tracking-wider"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              Open New Tab
            </a>
          </div>
        </div>
      </div>

      <!-- PDF Preview Container -->
      <div class="reveal">
        <div class="editorial-card border border-border/80 bg-surface/30 p-2 sm:p-4 rounded-2xl shadow-2xl relative overflow-hidden">

          <!-- Desktop / Embedded PDF Viewer -->
          <iframe
            src={`${pdfPath}#toolbar=0&navpanes=0`}
            title="CV Reyhan Albar Fahryan"
            class="w-full h-[750px] sm:h-[900px] rounded-xl border border-border/40 bg-surface"
          ></iframe>

          <!-- Fallback message -->
          <div class="mt-4 p-4 rounded-xl border border-border/40 bg-bg-alt flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono">
            <span class="text-text-dim">Cannot view PDF preview on your browser?</span>
            <a
              href={pdfPath}
              download="CV_Reyhan_Albar_Fahryan.pdf"
              class="text-accent hover:underline inline-flex items-center gap-1"
            >
              Click here to download CV_Reyhan_Albar_Fahryan.pdf →
            </a>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>
