---
import '../../styles/global.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SocialSidebar from '../../components/SocialSidebar.astro';
import { allProjects } from '../../data/projects';

const typeLabels: Record<string, string> = {
  web: 'Web',
  mobile: 'Mobile',
  data: 'Data',
  product: 'Product',
};

const statusColors: Record<string, string> = {
  'MVP': 'text-accent bg-accent/5 border-accent/15',
  'In Development': 'text-accent-secondary bg-accent-secondary/5 border-accent-secondary/15',
  'Academic': 'text-text-dim bg-text-dim/5 border-text-dim/15',
  'Collaboration': 'text-accent-secondary bg-accent-secondary/5 border-accent-secondary/15',
  'Internship Project': 'text-success bg-success/5 border-success/15',
  'Experiment': 'text-text-muted bg-text-muted/5 border-text-muted/15',
  'Production': 'text-success bg-success/5 border-success/15',
};

const typeIcons: Record<string, string> = {
  web: '◈',
  mobile: '◇',
  data: '◆',
  product: '○',
};
---

<BaseLayout
  title="All Projects — Reyhan Albar Fahryan"
  description="Full list of web, mobile, data, and product projects built by Reyhan Albar Fahryan."
>
  <SocialSidebar />
  <Navbar />

  <main class="min-h-screen bg-bg pt-28 pb-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Page Header -->
      <div class="mb-12 reveal">
        <a href="/" class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider text-text-dim hover:text-accent transition-colors mb-6 group">
          <svg class="w-3 h-3 rotate-180 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          Back to Home
        </a>
        <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent mb-3">/ ALL PROJECTS</p>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tighter uppercase leading-[0.95] font-display text-text">
          Full Build Log
        </h1>
        <p class="text-base text-text-muted mt-4 max-w-2xl font-light">
          Every project — web systems, mobile apps, data tools, and product experiments. {allProjects.length} builds and counting.
        </p>
      </div>

      <!-- Search & Filter Bar -->
      <div class="mb-10 reveal space-y-4">
        <!-- Search Input -->
        <div class="relative">
          <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-text-dim" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input
            id="project-search"
            type="text"
            placeholder="Search by name, tech, or category..."
            class="w-full bg-surface/50 border border-border/60 rounded-xl pl-10 pr-4 py-3 text-sm text-text placeholder:text-text-dim focus:outline-none focus:border-accent/50 focus:bg-surface transition-all duration-200 font-mono"
            autocomplete="off"
          />
        </div>

        <!-- Filter Pills -->
        <div class="flex flex-wrap gap-2" id="filter-pills" role="group" aria-label="Filter by type">
          {['all', 'web', 'mobile', 'data', 'product'].map((type) => (
            <button
              data-filter={type}
              class:list={[
                'filter-pill font-mono text-[10px] uppercase tracking-wider border rounded-lg px-3 py-1.5 transition-all duration-200 cursor-pointer',
                type === 'all'
                  ? 'bg-accent/10 border-accent/30 text-accent'
                  : 'bg-transparent border-border/40 text-text-dim hover:border-border-strong hover:text-text-muted',
              ]}
            >
              {type === 'all' ? 'All Projects' : typeLabels[type]}
            </button>
          ))}
        </div>

        <!-- Results Count -->
        <p id="results-count" class="font-mono text-[10px] text-text-dim uppercase tracking-wider">
          Showing {allProjects.length} projects
        </p>
      </div>

      <!-- Projects Grid -->
      <div
        id="projects-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger"
      >
        {allProjects.map((project) => (
          <article
            class="project-item editorial-card card-teal-glow border border-border/80 bg-surface/40 flex flex-col group hover:border-border-strong transition-all duration-300"
            data-type={project.type}
            data-title={project.title.toLowerCase()}
            data-tech={project.techStack.join(' ').toLowerCase()}
            data-category={project.category.toLowerCase()}
          >
            <!-- Visual Area -->
            <div class="aspect-[16/10] bg-bg-alt border-b border-border/40 flex items-center justify-center relative overflow-hidden select-none">
              {project.coverImage ? (
                <img
                  src={project.coverImage}
                  alt={`Screenshot of ${project.title}`}
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                />
              ) : (
                <span class="text-4xl text-accent/15 font-bold font-display group-hover:text-accent/25 group-hover:scale-110 transition-all duration-500">
                  {typeIcons[project.type]}
                </span>
              )}

              <!-- Type badge overlay -->
              <div class="absolute top-3 left-3">
                <span class="font-mono text-[8px] uppercase tracking-wider bg-bg/80 backdrop-blur-sm border border-border/60 text-text-dim rounded-md px-1.5 py-0.5">
                  {typeLabels[project.type]}
                </span>
              </div>

              {/* Featured badge */}
              {project.featured && (
                <div class="absolute top-3 right-3">
                  <span class="font-mono text-[8px] uppercase tracking-wider bg-accent/10 border border-accent/25 text-accent rounded-md px-1.5 py-0.5">
                    Featured
                  </span>
                </div>
              )}
            </div>

            <!-- Content -->
            <div class="p-5 flex flex-col flex-1 gap-3">
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-base font-semibold text-text leading-snug group-hover:text-accent transition-colors duration-200">
                  {project.title}
                </h2>
                <span class:list={['font-mono text-[8px] uppercase tracking-wider border rounded-full px-2 py-0.5 shrink-0 mt-0.5', statusColors[project.status] || statusColors['MVP']]}>
                  {project.status}
                </span>
              </div>

              <p class="font-mono text-[9px] uppercase tracking-wider text-text-dim">
                {project.category}
              </p>

              <p class="text-xs text-text-muted leading-relaxed font-light flex-1 line-clamp-2">
                {project.description}
              </p>

              <!-- Tech Stack -->
              <div class="flex flex-wrap gap-1">
                {project.techStack.slice(0, 3).map((tech) => (
                  <span class="font-mono text-[8px] text-text-dim bg-bg border border-border/40 rounded px-1.5 py-0.5">
                    {tech}
                  </span>
                ))}
                {project.techStack.length > 3 && (
                  <span class="font-mono text-[8px] text-text-dim px-1">+{project.techStack.length - 3}</span>
                )}
              </div>

              <!-- Links -->
              <div class="flex items-center gap-3 pt-2 border-t border-border/20 mt-auto">
                {project.featured ? (
                  <a
                    href={`/projects/${project.slug}`}
                    class="inline-flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-wider text-accent hover:text-accent/80 transition-colors duration-200"
                  >
                    Case Study
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                ) : null}
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-[10px] font-mono uppercase tracking-wider text-text-dim hover:text-text-muted transition-colors duration-200 ml-auto"
                >
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                  </svg>
                  GitHub
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden text-center py-20">
        <p class="font-mono text-text-dim text-sm">No projects found.</p>
        <p class="font-mono text-text-dim/50 text-xs mt-1">Try a different search term or filter.</p>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<!-- Search & Filter Logic -->
<script>
  const searchInput = document.getElementById('project-search') as HTMLInputElement;
  const filterPills = document.querySelectorAll('.filter-pill') as NodeListOf<HTMLButtonElement>;
  const items = document.querySelectorAll('.project-item') as NodeListOf<HTMLElement>;
  const countEl = document.getElementById('results-count');
  const emptyState = document.getElementById('empty-state');

  let activeFilter = 'all';
  let searchQuery = '';

  function updateResults() {
    let visible = 0;
    items.forEach((item) => {
      const type = item.dataset.type || '';
      const title = item.dataset.title || '';
      const tech = item.dataset.tech || '';
      const category = item.dataset.category || '';

      const matchesFilter = activeFilter === 'all' || type === activeFilter;
      const matchesSearch =
        searchQuery === '' ||
        title.includes(searchQuery) ||
        tech.includes(searchQuery) ||
        category.includes(searchQuery);

      if (matchesFilter && matchesSearch) {
        item.style.display = '';
        visible++;
      } else {
        item.style.display = 'none';
      }
    });

    if (countEl) {
      countEl.textContent = `Showing ${visible} project${visible !== 1 ? 's' : ''}`;
    }
    if (emptyState) {
      emptyState.classList.toggle('hidden', visible > 0);
    }
  }

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeFilter = pill.dataset.filter || 'all';

      // Update pill styles
      filterPills.forEach((p) => {
        const isActive = p.dataset.filter === activeFilter;
        if (isActive) {
          p.classList.add('bg-accent/10', 'border-accent/30', 'text-accent');
          p.classList.remove('bg-transparent', 'border-border/40', 'text-text-dim', 'hover:border-border-strong', 'hover:text-text-muted');
        } else {
          p.classList.remove('bg-accent/10', 'border-accent/30', 'text-accent');
          p.classList.add('bg-transparent', 'border-border/40', 'text-text-dim', 'hover:border-border-strong', 'hover:text-text-muted');
        }
      });

      updateResults();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
    updateResults();
  });
</script>
