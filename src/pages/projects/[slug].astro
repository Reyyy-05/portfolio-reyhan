---
import '../../styles/global.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SocialSidebar from '../../components/SocialSidebar.astro';
import { allProjects } from '../../data/projects';
import type { Project } from '../../data/projects';

export async function getStaticPaths() {
  return allProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusColors: Record<string, string> = {
  'MVP': 'text-accent bg-accent/5 border-accent/15',
  'In Development': 'text-accent-secondary bg-accent-secondary/5 border-accent-secondary/15',
  'Academic': 'text-text-dim bg-text-dim/5 border-text-dim/15',
  'Collaboration': 'text-accent-secondary bg-accent-secondary/5 border-accent-secondary/15',
  'Internship Project': 'text-success bg-success/5 border-success/15',
  'Experiment': 'text-text-muted bg-text-muted/5 border-text-muted/15',
  'Production': 'text-success bg-success/5 border-success/15',
};

const typeLabels: Record<string, string> = {
  web: 'Web System',
  mobile: 'Mobile App',
  data: 'Data System',
  product: 'Product / Experiment',
};

const statusClass = statusColors[project.status] || statusColors['MVP'];
const cardId = project.slug;
const hasViews = project.views && project.views.length > 0;
---

<BaseLayout
  title={`${project.title} — Reyhan Albar Fahryan`}
  description={project.description}
>
  <SocialSidebar />
  <Navbar />

  <main class="min-h-screen bg-bg pt-28 pb-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Back navigation -->
      <div class="mb-10 reveal">
        <a href="/projects" class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider text-text-dim hover:text-accent transition-colors group">
          <svg class="w-3 h-3 rotate-180 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          All Projects
        </a>
      </div>

      <!-- ── HERO ── -->
      <div class="mb-16 reveal space-y-5">
        <!-- Eyebrow row -->
        <div class="flex items-center gap-3 flex-wrap">
          <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-accent">
            / {typeLabels[project.type] || project.type}
          </span>
          <span class="text-border/60">·</span>
          <span class:list={['font-mono text-[10px] uppercase tracking-wider border rounded-full px-2 py-0.5', statusClass]}>
            {project.status}
          </span>
        </div>

        <!-- Title -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tighter uppercase leading-[0.92] font-display text-text">
          {project.title}
        </h1>

        <!-- Category -->
        <p class="font-mono text-xs uppercase tracking-wider text-text-dim">{project.category}</p>

        <!-- Description -->
        <p class="text-base md:text-lg text-text-muted leading-relaxed font-light max-w-2xl">
          {project.description}
        </p>

        {project.whyItMatters && (
          <p class="text-sm text-text-dim leading-relaxed border-l-2 border-accent/25 pl-4 italic max-w-xl">
            → {project.whyItMatters}
          </p>
        )}
      </div>

      <!-- ── COVER IMAGE / HERO VISUAL ── -->
      <div class="mb-16 reveal">
        <div class="editorial-card card-teal-glow border border-border/80 bg-surface/30 overflow-hidden aspect-[16/9] flex items-center justify-center relative">
          {project.coverImage ? (
            <img
              src={project.coverImage}
              alt={`Screenshot of ${project.title}`}
              class="w-full h-full object-cover object-top"
            />
          ) : (
            <!-- Premium CSS placeholder when no screenshot yet -->
            <div class="w-full h-full flex flex-col items-center justify-center gap-4 relative">
              <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(94,234,212,0.04)_0%,_transparent_70%)]"></div>
              <span class="font-display text-[8rem] font-bold text-text/3 leading-none tracking-tighter select-none">
                {project.title.charAt(0)}
              </span>
              <div class="absolute bottom-6 left-0 right-0 flex items-center justify-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse-dot"></span>
                <p class="font-mono text-[10px] text-text-dim uppercase tracking-wider">
                  / Screenshot coming soon — add to public/projects/{project.slug}/cover.png
                </p>
              </div>
            </div>
          )}
        </div>
      </div>

      <!-- ── TECH STACK ── -->
      <div class="mb-16 reveal">
        <div class="flex items-center gap-3 mb-6">
          <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-text-dim">/ TECH STACK</span>
          <div class="flex-1 h-px bg-border/40"></div>
        </div>
        <div class="flex flex-wrap gap-2">
          {project.techStack.map((tech) => (
            <span class="font-mono text-xs text-text-muted bg-surface border border-border/60 rounded-xl px-4 py-2 hover:border-accent/30 hover:text-accent transition-all duration-200 cursor-default">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- ── MULTI-VIEW SCREEN SWITCHER ── -->
      {hasViews && (
        <div class="mb-16 reveal" data-card-id={cardId}>
          <div class="flex items-center gap-3 mb-6">
            <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-text-dim">/ SCREEN VIEWS</span>
            <div class="flex-1 h-px bg-border/40"></div>
          </div>

          <!-- Tab Pills -->
          <div class="flex items-center gap-2 flex-wrap mb-4" role="tablist" aria-label={`${project.title} views`}>
            {project.views!.map((view, i) => (
              <button
                id={`tab-${cardId}-${view.id}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-tab={view.id}
                data-card={cardId}
                class:list={[
                  'view-tab-btn font-mono text-[10px] uppercase tracking-wider border rounded-lg px-3 py-1.5 transition-all duration-200 cursor-pointer',
                  i === 0
                    ? 'bg-accent/10 border-accent/30 text-accent'
                    : 'bg-transparent border-border/40 text-text-dim hover:border-border-strong hover:text-text-muted',
                ]}
              >
                {view.label}
              </button>
            ))}
          </div>

          <!-- Screen Panel Area -->
          <div class="editorial-card border border-border/80 bg-surface/20 overflow-hidden aspect-[16/10] flex items-center justify-center p-8 relative">
            {project.views!.map((view, i) => (
              <div
                id={`panel-${cardId}-${view.id}`}
                data-panel={`${cardId}-${view.id}`}
                class:list={['view-panel w-full h-full transition-opacity duration-300', i !== 0 && 'hidden']}
              >
                {view.image ? (
                  <!-- Real screenshot -->
                  <div class:list={['w-full h-full', project.type === 'mobile' ? 'flex items-center justify-center' : '']}>
                    {project.type === 'mobile' ? (
                      <div class="css-phone aspect-[9/16] h-full max-h-full flex flex-col overflow-hidden">
                        <div class="css-phone-notch"></div>
                        <img
                          src={view.image}
                          alt={`${project.title} — ${view.label}`}
                          class="flex-1 w-full object-cover object-top"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="css-browser w-full h-full flex flex-col">
                        <div class="css-browser-bar">
                          <div class="css-browser-dot"></div>
                          <div class="css-browser-dot"></div>
                          <div class="css-browser-dot"></div>
                        </div>
                        <img
                          src={view.image}
                          alt={`${project.title} — ${view.label}`}
                          class="flex-1 w-full object-cover object-top"
                          loading="lazy"
                        />
                      </div>
                    )}
                  </div>
                ) : (
                  <!-- Placeholder state -->
                  <div class="w-full h-full flex flex-col items-center justify-center gap-3 text-center">
                    <div class="w-12 h-12 rounded-2xl border border-border/60 bg-surface/60 flex items-center justify-center">
                      <svg class="w-5 h-5 text-text-dim" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                    </div>
                    <div class="space-y-1">
                      <p class="font-mono text-xs text-text-dim uppercase tracking-wider">{view.label}</p>
                      <p class="text-[11px] text-text-dim/60 font-mono">
                        Add: public/projects/{project.slug}/{view.id}.png
                      </p>
                    </div>
                    <p class="text-xs text-text-muted/70 max-w-sm font-light">{view.description}</p>
                  </div>
                )}
              </div>
            ))}

            <!-- View description overlay bottom -->
            <div class="absolute bottom-3 left-0 right-0 flex justify-center pointer-events-none">
              {project.views!.map((view, i) => (
                <p
                  id={`desc-${cardId}-${view.id}`}
                  class:list={[
                    'view-desc font-mono text-[9px] text-text-dim bg-bg/75 backdrop-blur-sm border border-border/30 rounded-lg px-3 py-1 transition-all duration-200',
                    i !== 0 && 'hidden',
                  ]}
                >
                  {view.description}
                </p>
              ))}
            </div>
          </div>
        </div>
      )}

      <!-- ── ACTION LINKS ── -->
      <div class="reveal">
        <div class="flex items-center gap-3 mb-6">
          <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-text-dim">/ LINKS</span>
          <div class="flex-1 h-px bg-border/40"></div>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            id={`link-github-${project.slug}`}
            class="editorial-card inline-flex items-center gap-2.5 border border-border/80 bg-surface/40 px-5 py-3 text-sm text-text-muted hover:text-text hover:border-border-strong transition-all duration-200 font-mono"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View Repository
          </a>

          {project.demo && (
            <a
              href={project.demo}
              target="_blank"
              rel="noopener noreferrer"
              id={`link-demo-${project.slug}`}
              class="editorial-card inline-flex items-center gap-2.5 border border-accent/30 bg-accent/5 px-5 py-3 text-sm text-accent hover:bg-accent/10 hover:border-accent/50 transition-all duration-200 font-mono"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              Live Demo
            </a>
          )}

          <a
            href="/projects"
            class="editorial-card inline-flex items-center gap-2.5 border border-border/40 bg-transparent px-5 py-3 text-sm text-text-dim hover:text-text-muted hover:border-border-strong transition-all duration-200 font-mono ml-auto"
          >
            ← All Projects
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>

<!-- Tab Switcher Script (reused from ProjectCard) -->
{hasViews && (
  <script define:vars={{ cardId, views: project.views }}>
    (function () {
      function init() {
        const tabs = document.querySelectorAll(`[data-tab][data-card="${cardId}"]`);
        if (!tabs.length) return;

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const viewId = tab.dataset.tab;

            tabs.forEach((t) => {
              const isActive = t.dataset.tab === viewId;
              t.setAttribute('aria-selected', isActive ? 'true' : 'false');
              if (isActive) {
                t.classList.remove('bg-transparent', 'border-border/40', 'text-text-dim', 'hover:border-border-strong', 'hover:text-text-muted');
                t.classList.add('bg-accent/10', 'border-accent/30', 'text-accent');
              } else {
                t.classList.remove('bg-accent/10', 'border-accent/30', 'text-accent');
                t.classList.add('bg-transparent', 'border-border/40', 'text-text-dim', 'hover:border-border-strong', 'hover:text-text-muted');
              }
            });

            views.forEach((view) => {
              const panel = document.getElementById(`panel-${cardId}-${view.id}`);
              const desc  = document.getElementById(`desc-${cardId}-${view.id}`);
              if (!panel) return;
              if (view.id === viewId) {
                panel.classList.remove('hidden');
                if (desc) desc.classList.remove('hidden');
              } else {
                panel.classList.add('hidden');
                if (desc) desc.classList.add('hidden');
              }
            });
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
)}
